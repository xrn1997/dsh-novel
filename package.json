{
  "name": "@xrn1997/dsh-novel",
  "version": "0.8.0",
  "description": "在 DeepSeek Harness（DSH）里读网络小说：legado 书源导入、书架与连续滚动阅读，附六个 AI 助手工具（dshnovel_ 前缀）",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "ebook",
    "legado",
    "reader"
  ],
  "author": "xrn1997",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrn1997/dsh-novel.git"
  },
  "homepage": "https://github.com/xrn1997/dsh-novel#readme",
  "bugs": {
    "url": "https://github.com/xrn1997/dsh-novel/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "test:pack": "pnpm build && vitest run --config vitest.pack.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "buffer-crc32": "1.0.0",
    "cheerio": "^1.0.0",
    "dom-serializer": "^3.0.0",
    "domhandler": "^5.0.3",
    "iconv-lite": "^0.7.3",
    "image-size": "2.0.4",
    "playwright-core": "1.63.0",
    "undici": "7.29.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.5.0",
    "@types/yauzl": "3.4.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "jsdom": "^30.0.1",
    "playwright": "1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
